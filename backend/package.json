{
  "name": "gadgetpe-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "GadgetPe partner-first Express backend with pincode-based tenant scope",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "check": "node --check src/server.js && node --check src/app.js",
    "build:backend-check": "npm run check",
    "build:frontend": "cd ../frontend && npm install && npm run build && cd ../backend && node scripts/copy-frontend.mjs",
    "build:full": "npm run check && npm run build:frontend",
    "test": "node --test test/**/*.test.mjs",
    "repair:auto-expired:dry": "node scripts/repair-auto-expired-by-alt-slot.mjs --dry-run",
    "repair:auto-expired:apply": "node scripts/repair-auto-expired-by-alt-slot.mjs --apply",
    "seed:partner-leads": "node scripts/seed-partner-leads.mjs",
    "repair:lead-ownership": "node scripts/repair-lead-ownership.mjs",
    "backfill:admin-metrics": "node scripts/backfill-admin-metrics.mjs",
    "migrate:deduction-rules:dry": "node scripts/migrate-deduction-rules-canonical.mjs --dry-run",
    "migrate:deduction-rules:apply": "node scripts/migrate-deduction-rules-canonical.mjs --apply",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:migrate:sqlite-to-postgres": "node src/db/prisma-migration.js"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0",
    "node-sqlite3-wasm": "^0.8.59",
    "xlsx": "^0.18.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "nodemon": "^3.1.4",
    "prisma": "^6.19.3",
    "supertest": "^7.1.1"
  },
  "engines": {
    "node": ">=18.17"
  }
}
