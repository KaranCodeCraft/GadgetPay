{
  "name": "gadgetpe-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "GadgetPe partner-first Express backend with pincode-based tenant scope",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "check": "node --check src/server.js && node --check src/app.js",
    "test": "node --test test/**/*.test.mjs",
    "seed:partner-leads": "node scripts/seed-partner-leads.mjs",
    "backfill:admin-metrics": "node scripts/backfill-admin-metrics.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0",
    "xlsx": "^0.18.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "nodemon": "^3.1.4",
    "supertest": "^7.1.1"
  },
  "engines": {
    "node": ">=18.17"
  }
}
